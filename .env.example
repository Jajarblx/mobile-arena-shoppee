# Production template. Keep the populated .env on the server, outside public/.
# Replace every REPLACE_WITH_* value and example domain before deployment.
# See DEPLOYMENT.md for local overrides and production requirements.
APP_NAME="Mobile Arena"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mobile-arena.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Use a dedicated production MySQL/MariaDB database and least-privilege user.
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DB_NAME
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configure a real transport so password reset email can be delivered.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@mobile-arena.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Storyblok Content Delivery API: use a public token for published content.
# Laravel currently calls the EU endpoint in app/Services/StoryblokService.php.
STORYBLOK_ACCESS_TOKEN=REPLACE_WITH_PUBLIC_DELIVERY_TOKEN
STORYBLOK_VERSION=published
STORYBLOK_CACHE_TTL=300

# Management API credentials are only for trusted maintenance tools such as
# scripts/populate-storyblok-home.php. Do not put them in the web runtime.
# STORYBLOK_PERSONAL_ACCESS_TOKEN=REPLACE_WITH_PERSONAL_ACCESS_TOKEN
# STORYBLOK_SPACE_ID=REPLACE_WITH_SPACE_ID
# STORYBLOK_REGION=eu

# Optional one-time admin seeder values; keep them out of the web runtime.
# MOBILE_ARENA_ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
# MOBILE_ARENA_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
# MOBILE_ARENA_ADMIN_MOBILE=REPLACE_WITH_ADMIN_MOBILE
# MOBILE_ARENA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Supply store-approved numeric policies before launch. If omitted, Laravel
# uses the demo defaults in config/mobile-arena.php; do not accept them blindly.
# MOBILE_ARENA_RESERVATION_MINUTES=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_VERIFICATION_MINUTES=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_LOW_STOCK_THRESHOLD=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_DELIVERY_LOCAL_FEE=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_DELIVERY_PROVINCE_FEE=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_DELIVERY_REGIONAL_FEE=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_DELIVERY_NATIONAL_FEE=REPLACE_WITH_APPROVED_NUMBER
# MOBILE_ARENA_REFUND_WINDOW_DAYS=REPLACE_WITH_APPROVED_NUMBER
MOBILE_ARENA_EMAIL_NOTIFICATIONS=false
